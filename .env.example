# Copy this file to `.env` and fill in your real values.
# `.env` should NOT be committed to source control.
# tools/render.py loads these automatically when run from the project root.

# HeyGen API credentials
# Get from: https://app.heygen.com/settings/api
HEYGEN_API_KEY=your_api_key_here

# HeyGen stock avatar and voice IDs — pick from app.heygen.com (Avatars / Voices tabs).
# Passed to the heygen-video skill on every render. One avatar/voice across all videos
# unless an individual script's frontmatter overrides for that specific video.
HEYGEN_AVATAR_ID=your_avatar_id_here
HEYGEN_VOICE_ID=your_voice_id_here
